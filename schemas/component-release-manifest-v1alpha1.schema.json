{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-luna.local/schemas/component-release-manifest-v1alpha1.json",
  "title": "Light Luna independent component release descriptor (DESIGN ONLY)",
  "description": "Signed metadata payload describes independently versioned packages. Validation of this schema does NOT verify cryptographic signatures, compatibility, or permit installation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifestSequence",
    "issuedAt",
    "expiresAt",
    "releaseChannel",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "lightluna.component-releases/v1alpha1"
    },
    "manifestSequence": {
      "type": "integer",
      "minimum": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseChannel": {
      "enum": [
        "stable",
        "candidate",
        "development",
        "revoked"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "sourceRevision": {
      "type": "string",
      "maxLength": 100
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "signingPolicyId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "kind",
        "version",
        "api",
        "compatibility",
        "target",
        "artifact",
        "operationClass",
        "requiresOwnerApproval"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,110}$"
        },
        "kind": {
          "enum": [
            "app",
            "brain",
            "executor",
            "module",
            "knowledge",
            "model"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "contentRevision": {
          "type": "integer",
          "minimum": 1
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "major"
          ],
          "properties": {
            "protocol": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{1,70}$"
            },
            "major": {
              "type": "integer",
              "minimum": 1
            },
            "minor": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "compatibility": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "minVersionInclusive"
            ],
            "properties": {
              "componentId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{2,110}$"
              },
              "minVersionInclusive": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
              },
              "maxVersionExclusive": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
              },
              "protocolMajor": {
                "type": "integer",
                "minimum": 1
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch"
          ],
          "properties": {
            "os": {
              "enum": [
                "linux",
                "any"
              ]
            },
            "arch": {
              "enum": [
                "amd64",
                "arm64",
                "any"
              ]
            },
            "kernelMin": {
              "type": "string",
              "maxLength": 80
            },
            "kernelFeatures": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 90
              }
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "format"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "unpackedBytesMax": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "enum": [
                "deb",
                "tar.zst",
                "knowledge-pack",
                "model-package"
              ]
            },
            "uri": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 1100
            }
          }
        },
        "operationClass": {
          "enum": [
            "knowledge-only",
            "unprivileged-process",
            "ui-control-plane",
            "privileged-executor",
            "kernel-attachment",
            "model-only"
          ]
        },
        "requiresOwnerApproval": {
          "type": "boolean"
        },
        "revokes": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "healthCheckContract": {
          "type": "string",
          "maxLength": 150
        }
      }
    }
  }
}
