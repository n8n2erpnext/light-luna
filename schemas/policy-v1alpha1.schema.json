{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightluna.io/schemas/policy-v1alpha1.schema.json",
  "title": "Light Luna P0 standalone Host/Edge policy (validation only)",
  "description": "P0 restricted schema: no nftables apply, ban, NAT, NetBird, WAF or Gateway capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "lightluna.io/v1alpha1"
    },
    "kind": {
      "const": "PolicyBundle"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "defaultInbound",
        "emergencyAccess",
        "autonomous"
      ],
      "properties": {
        "mode": {
          "enum": [
            "host",
            "edge"
          ]
        },
        "defaultInbound": {
          "enum": [
            "accept",
            "drop",
            "reject"
          ]
        },
        "emergencyAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "networks"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "networks": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "aliases": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
                "not": {
                  "const": "any"
                }
              },
              "type": {
                "enum": [
                  "cidr-set",
                  "port-set"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "cidr-set"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "port-set"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "priority",
              "direction",
              "source",
              "protocol",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "direction": {
                "enum": [
                  "input",
                  "output"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp",
                  "icmp",
                  "icmpv6"
                ]
              },
              "destinationPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "action": {
                "enum": [
                  "accept",
                  "drop",
                  "reject",
                  "log"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "autonomous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "allowRealBans",
            "maxBanTtlSeconds"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "observe",
                "shadow"
              ]
            },
            "allowRealBans": {
              "const": false
            },
            "maxBanTtlSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          }
        }
      }
    }
  }
}
